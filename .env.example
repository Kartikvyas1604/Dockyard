# ── Dockyard env ──────────────────────────────────────────────
# Copy to apps/web/.env.local and fill in.

# Wallet / chain
NEXT_PUBLIC_WALLETCONNECT_ID=
NEXT_PUBLIC_CHAIN_ID=1

# Demo mode: show fork-fill banner, relax some guards for the demo script
NEXT_PUBLIC_DEMO_FORK=0

# The Graph — Messari Standardized DEX subgraphs (comma-separated deployment URLs)
GRAPH_API_KEY=
GRAPH_SUBGRAPH_URLS=

# Hedera x402 Strategy Intel
HEDERA_NETWORK=testnet
HEDERA_OPERATOR_ID=
HEDERA_OPERATOR_KEY=
X402_FACILITATOR_URL=
INTEL_PRICE_HBAR=0.05
