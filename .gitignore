# ── Dependencies — never commit, anywhere in the monorepo ──────────────
node_modules/
node_modules
.pnpm-store/
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
bun.lockb
package-lock.json

# ── Build artifacts ─────────────────────────────────────────────────────
.next/
next-env.d.ts
out/
build/
dist/
*.tsbuildinfo
.turbo/

# ── Env & secrets — only .env.example is ever committed ─────────────────
.env
.env.*
!.env.example
*.pem
*.key
*.p12
credentials.json
secrets.json

# ── Test / coverage ─────────────────────────────────────────────────────
coverage/

# ── Foundry / Anvil fork artifacts ──────────────────────────────────────
forge/cache/
forge/out/
broadcast/
cache/

# ── Logs ────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log

# ── Local tooling state ─────────────────────────────────────────────────
.vercel
.hedera/
.wrangler/
.storybook-out/
storybook-static/

# ── OS / editor ─────────────────────────────────────────────────────────
